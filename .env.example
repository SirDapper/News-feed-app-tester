# Copy this file to .env (same folder) and fill in the values.
# .env is ignored by git, so your keys never leave your computer.

# Supabase: Project Settings > Data API (URL) and Project Settings > API Keys.
SUPABASE_URL=
# Publishable key (starts sb_publishable_; older projects call it "anon").
# The website and phone app use it to read stories. It is safe to share.
SUPABASE_PUBLISHABLE_KEY=
# Secret key (starts sb_secret_; older projects call it "service_role").
# Only the worker uses it, to save stories. Keep it private.
SUPABASE_SECRET_KEY=

# Anthropic: console.anthropic.com > API Keys. Turns on AI summaries. Keep it private.
ANTHROPIC_API_KEY=
SUMMARY_MODEL=claude-haiku-5-5
